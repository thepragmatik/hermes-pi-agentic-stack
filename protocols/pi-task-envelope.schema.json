{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thepragmatik.github.io/hermes-pi-agentic-stack/agent/protocols/pi-task-envelope.schema.json",
  "title": "Hermes to Pi Task Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["version","task_id","idempotency_key","phase","attempt","role","model_role","routing","objective","acceptance","workspace","capabilities","privacy","risk","policy","budget","evidence","rollback"],
  "properties": {
    "version": {"const": "2.2"},
    "task_id": {"type": "string","minLength": 6},
    "idempotency_key": {"type": "string","minLength": 8},
    "phase": {"enum": ["00-preflight","10-baseline-and-backup","20-context-and-skills","30-router","40-security-and-policy","50-pi-and-lsp","60-evaluation-and-promotion","70-upgrades-and-rollback"]},
    "attempt": {"type": "integer","minimum": 1,"maximum": 20},
    "role": {"enum": ["coder","reviewer","migration","test","diagnostic"]},
    "model_role": {"type":"string","pattern":"^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$","description":"Configuration role such as coding.default or review.default; volatile model/provider IDs stay outside the task envelope."},
    "routing": {
      "type":"object",
      "additionalProperties":false,
      "required":["mission_id","stage_id","workflow","decision_sha256"],
      "properties":{
        "mission_id":{"type":"string","minLength":1},
        "stage_id":{"type":"string","minLength":1},
        "workflow":{"enum":["pi_worker","review_worker","multi_stage"]},
        "decision_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "router_engine":{"type":"string"},
        "router_maturity":{"enum":["researched","designed","prototype","smoke-tested","shadow","canary","production-approved"]}
      }
    },
    "objective": {"type": "string","minLength": 10,"maxLength": 8000},
    "acceptance": {"type": "array","minItems": 1,"items": {"type": "string","minLength": 3}},
    "workspace": {"type": "object","additionalProperties": false,"required": ["repo","worktree","base_ref","write_globs"],"properties": {"repo":{"type":"string"},"worktree":{"type":"string"},"base_ref":{"type":"string"},"write_globs":{"type":"array","items":{"type":"string"}},"deny_globs":{"type":"array","items":{"type":"string"}}}},
    "capabilities": {"type":"object","additionalProperties":false,"required":["shell_profile","network_profile","tools"],"properties":{"shell_profile":{"type":"string"},"network_profile":{"type":"string"},"tools":{"type":"array","uniqueItems":true,"items":{"type":"string"}}}},
    "privacy": {"type":"object","additionalProperties":false,"required":["class","cloud_allowed","pii_action","secret_action"],"properties":{"class":{"enum":["PUBLIC","INTERNAL","CONFIDENTIAL","LOCAL_ONLY"]},"cloud_allowed":{"type":"boolean"},"pii_action":{"enum":["redact","tokenize","block"]},"secret_action":{"const":"block"}}},
    "risk": {"type":"object","additionalProperties":false,"required":["level","destructive","human_approval_required"],"properties":{"level":{"enum":["low","medium","high","critical"]},"destructive":{"type":"boolean"},"human_approval_required":{"type":"boolean"}}},
    "policy": {"type":"object","additionalProperties":false,"required":["policy_id","sha256"],"properties":{"policy_id":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
    "budget": {"type":"object","additionalProperties":false,"required":["max_turns","max_input_tokens","max_output_tokens"],"properties":{"max_turns":{"type":"integer","minimum":1},"max_input_tokens":{"type":"integer","minimum":1},"max_output_tokens":{"type":"integer","minimum":1},"deadline_seconds":{"type":"integer","minimum":1}}},
    "evidence": {"type":"object","additionalProperties":false,"required":["required"],"properties":{"required":{"type":"array","uniqueItems":true,"items":{"enum":["diff","tests","lsp_diagnostics","pii_scan","secret_scan","benchmark","review"]}},"paths":{"type":"array","items":{"type":"string"}}}},
    "rollback": {"type":"object","additionalProperties":false,"required":["checkpoint","strategy"],"properties":{"checkpoint":{"type":"string"},"strategy":{"type":"string"}}},
    "human_approval": {"type":["object","null"],"additionalProperties":false,"properties":{"approved_by":{"type":"string"},"approved_at":{"type":"string","format":"date-time"},"scope":{"type":"string"}}}
  },
  "allOf": [
    {
      "if": {"properties":{"privacy":{"properties":{"class":{"const":"LOCAL_ONLY"}},"required":["class"]}},"required":["privacy"]},
      "then": {
        "properties": {
          "privacy": {"properties":{"cloud_allowed":{"const":false}}},
          "capabilities": {"properties":{"network_profile":{"const":"none"}}}
        }
      }
    },
    {
      "if": {"properties":{"risk":{"properties":{"human_approval_required":{"const":true}},"required":["human_approval_required"]}},"required":["risk"]},
      "then": {
        "required":["human_approval"],
        "properties":{"human_approval":{"type":"object","required":["approved_by","approved_at","scope"]}}
      }
    }
  ]
}
