# LCM BASELINE environment for the clean Hermes uplift profile.
# Stable research pin: hermes-lcm v0.20.0. Re-verify current stable at execution time.
# Apply through the profile/service launcher, not global shell startup files.

# Core bounded-context behavior. Start with stable defaults; tune only from measured
# long-horizon accepted-task/context evidence on the host.
LCM_CONTEXT_THRESHOLD=0.35
LCM_FRESH_TAIL_COUNT=32
LCM_FRESH_TAIL_MAX_TOKENS=0
LCM_INCREMENTAL_MAX_DEPTH=3
LCM_LEAF_CHUNK_TOKENS=20000
LCM_DYNAMIC_LEAF_CHUNK_ENABLED=false
LCM_THRESHOLD_FULL_SWEEP_ENABLED=false

# Mnemosyne owns cross-session semantic memory in this architecture. Keep LCM's
# overlapping semantic/proactive/temporal memory families disabled.
LCM_EMBEDDINGS_ENABLED=false
LCM_PROACTIVE_RECALL_ENABLED=false
LCM_TEMPORAL_ROLLUPS_ENABLED=false

# Keep the optional slash/operator command surface closed in the autonomous profile.
# LCM diagnostics/tools remain available through the qualified plugin surface.
LCM_ENABLE_SLASH_COMMAND=false

# Periodic deep FTS integrity check; structural checks still run independently.
LCM_FTS_INTEGRITY_CHECK_INTERVAL_HOURS=24

# Do not set LCM_DATABASE_PATH by default. Stable LCM resolves an empty path to the
# active HERMES_HOME/lcm.db, preserving profile isolation. Pin an override only when
# the deployment architecture has an explicit reason and backup tests cover it.

# Do not enable LCM cloud embedding/rerank providers or forward-only sensitive-pattern
# redaction in this baseline. External egress/security policy remains authoritative.
